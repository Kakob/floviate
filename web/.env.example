# All configuration is optional for free, anonymous meditations.
# Account features and the preserved task workspace:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public resources. Leave blank until a real destination is ready.
# Next.js embeds these values at build time; restart/rebuild after editing.
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FREE_WORKSHEET_URL=
NEXT_PUBLIC_WORKBOOK_URL=
NEXT_PUBLIC_NEWSLETTER_URL=
# Defaults to the local /custom brief. This is not a checkout or subscription.
NEXT_PUBLIC_CUSTOM_MEDITATION_URL=
